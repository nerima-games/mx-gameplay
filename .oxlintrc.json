{
  "$schema": "https://oxc-project.github.io/oxc/schema/linter.json",
  // oxlint is the ONLY lint/format configuration in this repository.
  // There is deliberately no prettier, no biome and no .editorconfig.
  //
  // NOTE on the `Date.now()` ban: the Nix-provided oxlint does not implement
  // `no-restricted-syntax` or `no-restricted-properties`, and while
  // `no-restricted-globals` is listed by `oxlint --rules` it is not implemented
  // either (no checkmark). The ban is enforced structurally instead, by
  // `.ast-grep/rules/no-wall-clock-read.yml` (org-wide, Wave 0). The former
  // `scripts/check-dependency-whitelist.ts` mechanism that used to carry this
  // check was retired org-wide along with the api-lock/dependency-whitelist
  // scripts.
  "env": {
    "es2022": true,
    "node": true
  },
  "settings": {
    "typescript": {
      "version": "7.0"
    }
  },
  "plugins": [],
  // Categories are deliberately "off": this repository enables individual
  // rules explicitly below, not whole categories. Turning a category "warn"
  // blanket-enables every rule oxlint tags with that category (far more than
  // the curated list below — under nixpkgs' oxlint 1.73.0 this pulled in
  // ~57 rules never chosen here, such as no-magic-numbers, sort-keys,
  // capitalized-comments, no-undefined, no-ternary and id-length, none of
  // which appear in the curated "rules" block, and none of which fired
  // under the oxlint@0.12.0 package.json devDependency this repo used
  // before migrating to the Nix-provided binary). Rules are enumerated
  // explicitly so the lint contract does not grow silently with the oxlint
  // version. Same root cause and fix as mc-dev-meta PR #12 and mc-save's
  // earlier org-standardization pass.
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off"
  },
  "rules": {
    // TypeScript-specific rules
    // Prefer `type` over `interface` for pure data types (Schema.Struct pattern).
    // Exception in this repo: the plan.md §4.1 contracts (StageRegistration, GameModule)
    // are reproduced verbatim as `interface` so the spec and the code read identically.
    "@typescript-eslint/consistent-type-definitions": ["warn", "type"],
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-unused-vars": "warn",
    "@typescript-eslint/no-floating-promises": "warn",
    "@typescript-eslint/no-misused-new": "warn",
    "@typescript-eslint/no-unnecessary-type-assertion": "warn",
    "@typescript-eslint/no-var-requires": "warn",
    "@typescript-eslint/prefer-enum-initializers": "warn",
    "@typescript-eslint/prefer-for-of": "warn",
    "@typescript-eslint/prefer-literal-enum-member": "warn",

    // Correctness
    "no-array-constructor": "warn",
    "no-empty": "warn",
    "no-eq-null": "warn",
    "no-extra-boolean-cast": "warn",
    "no-fallthrough": "warn",
    "no-irregular-whitespace": "warn",
    "no-self-compare": "warn",
    "no-throw-literal": "warn",
    "no-unreachable": "warn",
    "use-isnan": "warn",
    "valid-typeof": "warn",

    // Suspicious
    "no-console": "warn",
    "no-debugger": "warn",
    "no-empty-function": "warn",
    "no-empty-pattern": "warn",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-redeclare": "warn",
    "no-shadow": "warn",
    "no-unreachable-loop": "warn",
    "no-unused-private-class-members": "warn",

    // Performance
    "no-await-in-loop": "warn",
    "no-loop-func": "warn",
    "no-promise-executor-return": "warn",
    "no-sync": "warn",

    // Style
    // NOTE: as of oxlint 1.73.0, oxlint does not implement any ESLint-core
    // *formatting* rules at all (array-bracket-spacing, block-spacing,
    // brace-style, camelcase, comma-dangle, comma-spacing, comma-style,
    // computed-property-spacing, eol-last, func-call-spacing, indent,
    // key-spacing, keyword-spacing, linebreak-style,
    // lines-between-class-members, no-mixed-spaces-and-tabs, no-new-object,
    // no-tabs, no-trailing-spaces, no-whitespace-before-property,
    // object-curly-spacing, one-var, operator-linebreak, padded-blocks,
    // quote-props, semi-spacing, space-before-blocks, space-infix-ops,
    // space-unary-ops, spaced-comment). Verified empirically against oxlint
    // 1.73.0: `oxlint --print-config` hard-fails ("Rule 'X' not found in
    // plugin 'eslint'") on every one of them. This was previously masked
    // because the pinned oxlint@0.12.0 devDependency silently ignored both
    // the unknown `"ignore"` config key and these unknown rule names instead
    // of erroring (see flake.nix's comment on why oxlint moved to the Nix
    // devShell). Oxlint's stance is that formatting is a formatter's job
    // (Oxfmt), not the linter's; there is deliberately no replacement
    // configured here since this repo runs no formatter (see the top-of-file
    // note). If any of these are needed again, they must be loaded via
    // oxlint's JS plugin system (stylistic ESLint plugin), not as bare rule
    // names.
    "no-array-method-this-argument": "warn",
    "no-bitwise": "warn",

    // Restriction
    "default-case": "warn",
    "default-case-last": "warn",
    "no-empty-character-class": "warn",
    // Declared for intent and for the day oxlint implements it; inert in 0.12.
    // The real enforcement lives in scripts/check-dependency-whitelist.ts.
    "no-restricted-globals": ["warn", "name", "open", "close", "event"],
    // DEPENDENCY_POLICY.md §1: mx-gameplay is Tier3 (experience module) and may
    // depend only on mc-sim, mc-worldgen, mc-audio, and mc-kernel. Allow-list
    // form (Wave 0, D.9): `@nerima-games/**` is forbidden except the packages
    // named with a leading `!`. A forbidden import added under `test/**/*.ts`
    // with `.oxlintrc.json` scoped to `src test scripts apps` was used to
    // verify this block fires (see the PR body for the captured error line).
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "effect",
            "importNames": ["default"],
            "message": "Please use named imports from 'effect' package"
          }
        ],
        "patterns": [
          {
            "group": [
              "@nerima-games/**",
              "!@nerima-games/mc-kernel",
              "!@nerima-games/mc-kernel/**",
              "!@nerima-games/mc-sim",
              "!@nerima-games/mc-sim/**",
              "!@nerima-games/mc-worldgen",
              "!@nerima-games/mc-worldgen/**",
              "!@nerima-games/mc-audio",
              "!@nerima-games/mc-audio/**"
            ],
            "message": "mx-gameplay is Tier3 (DEPENDENCY_POLICY.md §1); only the listed packages may be imported."
          }
        ]
      }
    ],
    "prefer-template": "warn",

    // Disabled rules (conflict with project style)
    "@typescript-eslint/explicit-function-return-type": "off",
    "@typescript-eslint/explicit-module-boundary-types": "off",
    "@typescript-eslint/no-non-null-assertion": "off",
    "no-case-declarations": "off",
    "no-constant-condition": "off",
    "no-param-reassign": "off",
    "no-plusplus": "off"
  },
  "ignorePatterns": ["node_modules/**", "coverage/**", "dist/**", ".git/**", "*.config.ts", "docs/**"],
  "overrides": [
    {
      // CLI scripts, not shipped src/: console output is their literal
      // product (clean-dist.mjs / verify-package.mjs progress and errors).
      "files": ["scripts/**"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      // PERFORMANCE / CORRECTNESS EXCEPTION, same class as mc-noise's
      // documented no-bitwise exception. Every flagged operator in these
      // files is uint32 wrapping arithmetic (`>>> 0`, `^`, `Math.imul`) that
      // defines a deterministic hash or PRNG mix: villager-trade.ts's FNV-1a
      // offer hash, enchantment.ts's seed mixer, weather-gameplay.ts's LCG
      // tick, and registration.ts's restore of a persisted weather seed.
      // Rewriting these with non-bitwise arithmetic would change the
      // seed -> value mapping, which is the specification, not an
      // implementation detail.
      "files": [
        "src/domain/villager-trade.ts",
        "src/domain/enchantment.ts",
        "src/domain/weather-gameplay.ts",
        "src/stages/registration.ts"
      ],
      "rules": {
        "no-bitwise": "off"
      }
    }
  ]
}

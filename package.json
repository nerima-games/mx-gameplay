{
  "name": "@nerima-games/mx-gameplay",
  "version": "0.1.64",
  "type": "module",
  "description": "Experience module for the nerima-games Minecraft-clone rebuild: the rules of play — mining and placement, item use, mob behaviour, drops, fluid propagation, vehicles, portals, day/night and weather.",
  "homepage": "https://github.com/nerima-games/mx-gameplay#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerima-games/mx-gameplay.git"
  },
  "bugs": {
    "url": "https://github.com/nerima-games/mx-gameplay/issues"
  },
  "author": "takeokunn",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.15.0"
  },
  "packageManager": "pnpm@9.15.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "tsconfig.base.json",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "minecraft",
    "effect-ts",
    "typescript",
    "voxel",
    "gameplay"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.build.json --pretty false && tsc -p tsconfig.test.json --pretty false && tsc -p tsconfig.preview.json --pretty false",
    "lint": "oxlint --deny-warnings src scripts test apps",
    "lint:fix": "oxlint --fix src scripts test apps",
    "preview": "tsx apps/preview-mining-site/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@nerima-games/mc-audio": "0.1.0",
    "@nerima-games/mc-kernel": "0.2.16",
    "@nerima-games/mc-sim": "0.1.32",
    "@nerima-games/mc-worldgen": "0.1.0",
    "effect": "^3.20.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@effect/vitest": "^0.25.1",
    "@types/node": "^22.19.11",
    "@vitest/coverage-v8": "^3.2.4",
    "oxlint": "^0.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "@nerima-games/mc-kernel": "0.2.16"
    }
  }
}

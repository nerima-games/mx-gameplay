# Hoist fast-check for TypeScript type resolution
# Keep fast-check visible at the project root for TypeScript and Vite resolution.
public-hoist-pattern[]=fast-check
# pure-rand is a runtime dependency of fast-check; must be hoisted alongside it
# so Vite can resolve it from the flat node_modules/fast-check location
public-hoist-pattern[]=pure-rand

# Resolve @nerima-games/* from GitHub Packages, not public npm.
# publishConfig only governs where a publish goes; without this line an INSTALL
# would resolve against npmjs.com, where the scope is unclaimed and these
# package names are public knowledge once the repositories are.
@nerima-games:registry=https://npm.pkg.github.com
